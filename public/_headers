# Cloudflare Pages / Workers static-assets _headers
# Hashed Vite outputs: 1y immutable (filename changes on every content change)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed top-level static files: 24h (long enough to satisfy Lighthouse,
# short enough that ads.txt / robots.txt edits propagate within a day)
/ads.txt
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400
/manifest.json
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/og-image.svg
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400

# Site-wide security headers (no Cache-Control here — SPA shell needs to revalidate)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
